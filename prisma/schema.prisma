generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Currency {
  id        String    @id @default(uuid())
  code      String    @unique
  name      String
  symbol    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  accounts  Account[]
}

model AccountType {
  id        String    @id @default(uuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  accounts  Account[]
}

model Account {
  id               String        @id @default(uuid())
  name             String
  initialBalance   Decimal       @default(0) @db.Decimal(12, 2)
  isActive         Boolean       @default(true)
  currencyId       String
  accountTypeId    String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  accountType      AccountType   @relation(fields: [accountTypeId], references: [id])
  currency         Currency      @relation(fields: [currencyId], references: [id])
  transactions Transaction[] @relation("TransactionFromAccount")

  @@index([currencyId])
  @@index([accountTypeId])
}

model Category {
  id               String          @id @default(uuid())
  name             String
  isActive         Boolean         @default(true)
  excludeFromStats Boolean         @default(false)
  bucket           CategoryBucket?
  parentId         String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  budgets             Budget[]
  parent              Category?     @relation("CategoryParent", fields: [parentId], references: [id])
  children            Category[]    @relation("CategoryParent")
  transactions        Transaction[]
  transferAppSettings AppSettings[] @relation("TransferCategory")

  @@index([parentId])
  @@index([excludeFromStats])
}

model Transaction {
  id                  String          @id @default(uuid())
  type                TransactionType
  amount              Decimal         @db.Decimal(12, 2)
  description         String?
  friendlyName        String?         @db.VarChar(255)
  notes               String?         @db.Text
  date                DateTime        @db.Date
  importRef           String?         @unique
  fromAccountId       String
  categoryId          String?
  needsReview         Boolean         @default(false)
  parentTransactionId String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  category            Category?       @relation(fields: [categoryId], references: [id])
  fromAccount         Account         @relation("TransactionFromAccount", fields: [fromAccountId], references: [id])
  parent              Transaction?    @relation("TransactionSplits", fields: [parentTransactionId], references: [id], onDelete: Cascade)
  splits              Transaction[]   @relation("TransactionSplits")

  @@index([date])
  @@index([type])
  @@index([fromAccountId])
  @@index([categoryId])
  @@index([parentTransactionId])
}

model Budget {
  id         String   @id @default(uuid())
  year       Int
  amount     Decimal  @db.Decimal(12, 2)
  categoryId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  category   Category @relation(fields: [categoryId], references: [id])

  @@unique([year, categoryId])
  @@index([year])
}

model ImportProfile {
  id        String   @id @default(uuid())
  name      String   @unique
  fileType  String   // "csv" or "xlsx"
  columnMap Json     // { date: 0, description: 1, amount: 2, reference?: 3 }
  dateFormat String  @default("yyyy-MM-dd")
  delimiter String?  // CSV delimiter override (null = auto-detect)
  skipRows  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AppSettings {
  id                 String    @id @default("singleton")
  transferCategoryId String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  transferCategory   Category? @relation("TransferCategory", fields: [transferCategoryId], references: [id], onDelete: SetNull)
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum CategoryBucket {
  NEEDS
  WANTS
  SAVINGS
}
