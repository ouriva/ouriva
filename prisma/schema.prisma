generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Currency {
  id        String    @id @default(uuid())
  code      String    @unique
  name      String
  symbol    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  accounts  Account[]
}

model AccountType {
  id        String    @id @default(uuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  accounts  Account[]
}

model Account {
  id               String        @id @default(uuid())
  name             String
  initialBalance   Decimal       @default(0) @db.Decimal(12, 2)
  isActive         Boolean       @default(true)
  currencyId       String
  accountTypeId    String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  accountType      AccountType   @relation(fields: [accountTypeId], references: [id])
  currency         Currency      @relation(fields: [currencyId], references: [id])
  transactionsFrom Transaction[] @relation("TransactionFromAccount")
  transactionsTo   Transaction[] @relation("TransactionToAccount")

  @@index([currencyId])
  @@index([accountTypeId])
}

model Category {
  id           String        @id @default(uuid())
  name         String
  isActive     Boolean       @default(true)
  parentId     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  budgets      Budget[]
  parent       Category?     @relation("CategoryParent", fields: [parentId], references: [id])
  children     Category[]    @relation("CategoryParent")
  transactions Transaction[]

  @@index([parentId])
}

model Transaction {
  id            String          @id @default(uuid())
  type          TransactionType
  amount        Decimal         @db.Decimal(12, 2)
  description   String?
  date          DateTime        @db.Date
  importRef     String?         @unique
  fromAccountId String
  toAccountId   String?
  toAmount      Decimal?        @db.Decimal(12, 2)
  categoryId    String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  category      Category?       @relation(fields: [categoryId], references: [id])
  fromAccount   Account         @relation("TransactionFromAccount", fields: [fromAccountId], references: [id])
  toAccount     Account?        @relation("TransactionToAccount", fields: [toAccountId], references: [id])

  @@index([date])
  @@index([type])
  @@index([fromAccountId])
  @@index([toAccountId])
  @@index([categoryId])
}

model Budget {
  id         String   @id @default(uuid())
  year       Int
  amount     Decimal  @db.Decimal(12, 2)
  categoryId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  category   Category @relation(fields: [categoryId], references: [id])

  @@unique([year, categoryId])
  @@index([year])
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}
