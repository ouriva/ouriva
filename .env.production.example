# ============================================================
# Ouriva — Production Environment Variables
# ============================================================
# Copy this file to .env.production.local and fill in real values.
# .env.production.local is gitignored and will never be committed.
#
# Usage:
#   cp .env.production.example .env.production.local
#   # Then edit .env.production.local with your actual values
# ============================================================

# --- Deploy Script Configuration ---

# SSH host for the Raspberry Pi (matches your ~/.ssh/config entry)
PI_SSH=raspberry-pi

# Directory on the Pi where docker-compose.yml lives
# IMPORTANT: Use the full path, not ~ (tilde expands to your Mac's home)
PI_APP_DIR=/home/pi/ouriva

# SSH host for the database server (for running migrations)
DB_SSH=ubuntu-server_homelab

# Production database URL for migrations (uses your DB admin user)
# homelab_admin has DDL privileges needed for CREATE TABLE, ALTER, etc.
# Port 5433 is used to avoid conflict with the dev tunnel on 5432
MIGRATE_DB_URL=postgresql://homelab_admin:CHANGE_ME@localhost:5433/personal_finance

# SSH host where backups are stored (matches your ~/.ssh/config entry).
# Deploy only pg_dumps the database when a migration is about to run,
# and ships the dump here before applying it.
BACKUP_SSH=backup-host

# Directory on BACKUP_SSH to store pre-migration dumps (must be on
# durable/external storage, not the host's root disk)
BACKUP_DIR=/mnt/backups/db-backups

# --- Docker Compose Configuration (used on the Raspberry Pi) ---

# Production database URL for the app (uses the restricted budget_app user)
# <db-host> = LAN IP of your database server (e.g., 192.168.1.X)
DATABASE_URL=postgresql://budget_app:CHANGE_ME@CHANGE_DB_HOST:5432/personal_finance
