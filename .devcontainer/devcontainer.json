{
  "name": "Ouriva Demo",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/ouriva",

  // Port visibility defaults to Private, which requires the viewer
  // to be authenticated as the codespace owner — fine for one
  // person's own Codespace, but this one is meant to be opened by
  // any visitor clicking "Try it now" on the landing page, who
  // isn't authenticated as anyone. Without "public" here, every
  // new codespace hits the exact same auth wall this one did
  // before it was manually toggled — this makes that automatic.
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Ouriva",
      "onAutoForward": "openPreview",
      "visibility": "public"
    }
  },

  // Installs deps, generates the Prisma client, applies migrations,
  // and seeds realistic sample data once, when the container is
  // first created. "prisma generate" is explicit rather than relied
  // on as an install side-effect — there's no postinstall hook in
  // package.json, and whatever generated it implicitly during local
  // testing didn't happen the same way in real Codespaces, which
  // failed with "Cannot find module '../src/generated/prisma/client.js'".
  // The production Dockerfile already calls this explicitly for the
  // same reason.
  "postCreateCommand": "npm ci && npx prisma generate && npx prisma migrate deploy && npx prisma db seed",

  // Starts the dev server automatically so the app is already
  // running by the time the codespace finishes opening — nothing
  // for the visitor to type. Two earlier attempts at this failed
  // on real Codespaces (plain "nohup ... &", then "setsid nohup
  // ... &") — both left an empty log and no running process, which
  // was my own reasoning about signals/process groups, not a
  // documented pattern, and it was wrong twice.
  //
  // This is Microsoft's own documented pattern instead:
  // https://code.visualstudio.com/remote/advancedcontainers/start-processes
  // "nohup bash -c '<command> &'" — the inner bash backgrounds the
  // command and then exits immediately, which orphans it to be
  // reparented by the kernel to init. That's a real OS-level
  // detachment guarantee, not a session/group trick.
  "postStartCommand": "nohup bash -c 'npm run dev -- -H 0.0.0.0 > /tmp/ouriva-dev.log 2>&1 &'",

  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "bradlc.vscode-tailwindcss"]
    }
  }
}
