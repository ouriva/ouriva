{
  "name": "Ouriva Demo",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/ouriva",

  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Ouriva",
      "onAutoForward": "openPreview"
    }
  },

  // Installs deps, generates the Prisma client, applies migrations,
  // and seeds realistic sample data once, when the container is
  // first created. "prisma generate" is explicit rather than relied
  // on as an install side-effect — there's no postinstall hook in
  // package.json, and whatever generated it implicitly during local
  // testing didn't happen the same way in real Codespaces, which
  // failed with "Cannot find module '../src/generated/prisma/client.js'".
  // The production Dockerfile already calls this explicitly for the
  // same reason.
  "postCreateCommand": "npm ci && npx prisma generate && npx prisma migrate deploy && npx prisma db seed",

  // Starts the dev server automatically so the app is already
  // running by the time the codespace finishes opening — nothing
  // for the visitor to type. Real Codespaces killed a plain
  // "nohup ... &" the moment this lifecycle command returned: nohup
  // only blocks the hangup signal, it doesn't detach the process
  // from its process group, so the container runtime reaping that
  // group after the hook "finishes" took the dev server with it —
  // silently, with an empty log and a 502 on the forwarded port.
  // setsid starts it in a brand new session (fully detached from
  // that process group) and </dev/null closes stdin, which together
  // is the standard way to actually daemonize a background process
  // rather than just suppress one signal.
  "postStartCommand": "setsid nohup npm run dev -- -H 0.0.0.0 </dev/null >/tmp/ouriva-dev.log 2>&1 &",

  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "bradlc.vscode-tailwindcss"]
    }
  }
}
