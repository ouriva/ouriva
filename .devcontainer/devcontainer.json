{
  "name": "Ouriva Demo",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/ouriva",

  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Ouriva",
      "onAutoForward": "openPreview"
    }
  },

  // Installs deps, generates the Prisma client, applies migrations,
  // and seeds realistic sample data once, when the container is
  // first created. "prisma generate" is explicit rather than relied
  // on as an install side-effect — there's no postinstall hook in
  // package.json, and whatever generated it implicitly during local
  // testing didn't happen the same way in real Codespaces, which
  // failed with "Cannot find module '../src/generated/prisma/client.js'".
  // The production Dockerfile already calls this explicitly for the
  // same reason.
  "postCreateCommand": "npm ci && npx prisma generate && npx prisma migrate deploy && npx prisma db seed",

  // Starts the dev server automatically so the app is already
  // running by the time the codespace finishes opening — nothing
  // for the visitor to type. Backgrounded so this command can
  // return immediately.
  "postStartCommand": "nohup npm run dev -- -H 0.0.0.0 > /tmp/ouriva-dev.log 2>&1 &",

  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "bradlc.vscode-tailwindcss"]
    }
  }
}
