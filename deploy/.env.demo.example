# ============================================================
# Ouriva — Demo Stack Environment
# ============================================================
# Copy this file to .env.demo (gitignored) and set a real
# password before starting the demo stack:
#
#   cp deploy/.env.demo.example deploy/.env.demo
#   # edit deploy/.env.demo with a generated password:
#   openssl rand -hex 16
#
# Compose reads .env.demo automatically when you pass
# --env-file deploy/.env.demo (see reset-demo.sh).
# ============================================================

DEMO_DB_PASSWORD=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND
